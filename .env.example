NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development
RACESIDE_RELEASE_SHA=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (optional). Keep SENTRY_AUTH_TOKEN out of runtime .env files and inject it only in CI builds.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_WORKER_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email / SMTP
RESEND_API_KEY=
AUTH_EMAIL_FROM=no-reply@example.com
BILLING_EMAIL_FROM=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=RaceSide
AUTH_SMTP_MAX_FREQUENCY=1
AUTH_RATE_LIMIT_EMAIL_SENT=10000
AUTH_RATE_LIMIT_OTP=10000
AUTH_RATE_LIMIT_VERIFY=10000
AUTH_RATE_LIMIT_TOKEN_REFRESH=10000

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=RaceSide
OPENROUTER_TIMEOUT_MS=60000
AI_SUMMARY_MODEL=openai/gpt-6-luna
AI_DIGEST_MODEL=openai/gpt-6-luna
REPORT_SUMMARY_MODEL=openai/gpt-6-luna
AI_SUMMARY_MAX_TOKENS=450
REPORT_SUMMARY_MAX_TOKENS=1200
AI_DAILY_COST_LIMIT_USD=5
AI_MONTHLY_COST_LIMIT_USD=100
AI_MAX_ARTICLES_PER_RUN=50
NEWS_DEDUP_ENABLED=true
NEWS_DEDUP_WINDOW_HOURS=168
NEWS_DEDUP_MAX_CANDIDATES=10
NEWS_DEDUP_CONFIDENCE_THRESHOLD=0.85
NEWS_DEDUP_FAIL_MODE=hold
NEWS_DEDUP_AI_RETRY_COUNT=2
NEWS_DEDUP_AI_MODEL=openai/gpt-6-luna
NEWS_DEDUP_MAX_TOKENS=1200

# External data
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
OPENF1_BASE_URL=https://api.openf1.org/v1
# Optional sponsor credentials. Without them, current-session data unlocks about 30 minutes after the finish.
OPENF1_USERNAME=
OPENF1_PASSWORD=
OPENF1_ACCESS_TOKEN=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
SOCIAL_X_ACCOUNTS=https://x.com/F1TelemetryData
SOCIAL_X_OFFICIAL_HANDLES=f1,fia,scuderiaferrari,mercedesamgf1,redbullracing,mclarenf1
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RaceSide/1.0 by raceside.online
SOCIAL_REDDIT_SUBREDDITS=formula1
SOCIAL_AI_MODEL=openai/gpt-6-luna
SOCIAL_AI_MAX_POSTS_PER_RUN=30

# Worker / Queue
WORKER_CONCURRENCY=3
RSS_FETCH_INTERVAL_MINUTES=30
SOCIAL_MAX_POSTS_PER_SOURCE=30
REPORTS_REFRESH_LIMIT=3
FASTF1_PYTHON_BIN=/opt/fastf1/bin/python
FASTF1_TIMEOUT_MS=60000
FASTF1_CACHE_DIR=/tmp/racemate-fastf1-cache
REDIS_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=raceside_bot
TELEGRAM_WEBHOOK_SECRET=
# Отдельный бот для технических сообщений. Сначала отправьте ему /start.
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_SUPPORT_USERNAME=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_FETCH_CONCURRENCY=2
TELEGRAM_ALBUM_SETTLE_SECONDS=30
TELEGRAM_EDIT_LOOKBACK_MESSAGES=20
TELEGRAM_MAX_MESSAGES_PER_SOURCE=2000
TELEGRAM_MEDIA_MAX_BYTES=52428800
NOTIFICATION_DISPATCH_LIMIT=100

# Admin
ADMIN_EMAILS=

# RaceSide LIVE. OpenF1 credentials above are server-only.
# Development simulator: LIVE_DATA_SOURCE=replay pnpm live
LIVE_INTERNAL_ORIGIN=http://127.0.0.1:3002
LIVE_DATA_SOURCE=openf1
LIVE_REPLAY_SESSION_KEY=11334
LIVE_REPLAY_SESSION_TYPE=Race
LIVE_ACCESS_SECRET=
LIVE_MAX_CONNECTIONS_PER_USER=3

# RaceSide Plus billing. Enable enforcement only after applying the billing migration.
BILLING_CHECKOUT_ENABLED=false
BILLING_ENTITLEMENTS_ENFORCED=false
BILLING_ADS_ENABLED=false
BILLING_LAVA_ENABLED=false
LAVA_API_KEY=
LAVA_WEBHOOK_SECRET=
# Published subscription offer with MONTHLY and PERIOD_YEAR prices in RUB and USD.
LAVA_OFFER_ID=
LAVA_API_BASE=https://gate.lava.top
# Legacy credentials: only historical notifications/reconciliation, never new checkout.
YOOMONEY_RECEIVER=
YOOMONEY_NOTIFICATION_SECRET=
YOOMONEY_RECONCILE_SECRET=
TRIBUTE_API_KEY=
# Radio transcription is fixed to OpenRouter openai/gpt-transcribe.
# Translation uses the shared GPT-6 Luna text model and existing AI spend limits.
