  "adjacentSignalRegression": {
    "laps": 72,
    "weakAccelerationBefore": 18,
    "weakAccelerationAfter": 18,
    "differences": 0,
    "finding": "An initial shared full-throttle run split exposed two unrelated weak-acceleration events in Sepang. Fixed by preserving pressed-pedal runs for weak acceleration and using full-throttle runs only for superclipping; covered by a failing-then-passing regression test."
  },
  "rules": {
    "slowSpeed": 150,
    "fastSpeed": 230,
    "maxGap": 0.6,
    "neutralSeconds": 0.05,
    "maxSectorError": 0.35,
    "fullThrottle": 98,
    "pressedThrottle": 5,
    "speedDrop": 8,
    "minSignalSpeed": 200,
    "minSuperclippingStartSpeed": 300,
    "minSignalDuration": 1,
    "minSignalDistance": 60,
    "maxSignalGap": 0.5,
    "maxSignalMergeSeconds": 1.5,
    "maxSignalMergeDistance": 150,
    "maxSignalSpeedRecovery": 2
  },
  "scope": "72 real cached lap traces across five circuits, 64 comparable and eight pit/cooldown traces. Fixed rule, no per-lap overrides; shared corridors use nearest-in-time other driver. Full cached traces scaled to verified track length. No external writes.",
  "primarySources": [
    {
      "url": "https://www.formula1.com/en/latest/article/f1-2026-regulations-explained-the-key-terms-for-formula-1s-new-for-2026-rules.3T5BU6TC9quGcIpGzoWkY0",
      "finding": "Harvesting at full throttle, usually at the end of a straight; depends on maps and circuit. No universal minimum speed stated."
    },
    {
      "url": "https://global.honda/jp/tech/motorsports/Formula-1/glossary/terms/Super_Clipping/",
      "finding": "ICE power drives MGU-K generation while the throttle stays fully pressed. Used for mechanism only, not numerical regulatory power limits."
    }
  ],
  "limitations": [
    "No battery/SOC/MGU-K channels: detections do not establish energy cause.",
    "300 km/h is a conservative product threshold, not a physical lower limit; it can miss real lower-speed harvesting.",
    "Missing samples cannot establish unseen pedal changes, despite bounded interpolation and consistent observed endpoints.",
    "Straight/fast categories and distance are approximate; Monza and Madring geometry is estimated.",
    "Only merges already established decline fragments; a short tail alone is not extrapolated through a corner.",
    "Eight noncomparable pit/cooldown traces included separately for robustness, not evidence for track position or true positives."
  ],
  "hypotheses": {
    "fullThrottle": "60% gas false positive removed; every sample checked, not event average.",
    "entrySpeed": "250/260/280/290/300/310 tested. 300 retains all high-speed candidates in Baku/Monza/Madring, removes 243 approach and 283/286 corner-adjacent episodes in Spa. All-sample speed cutoff rejected because it truncates valid high-speed-start declines.",
    "merging": "Pause 0.5/0.75/1/1.25/1.5/2/3 seconds, distance 60/100/150/200/250 m and recovery 0/1/2/3/5/8 km/h swept. 1.5 seconds and 150 m join six pairs in Spa; raising limits did not join more in these data. Recovery allowance selected for integer speed noise; negatives also tested synthetically.",
    "reacceleration": "Production fixes an internal recovery loophole independently of fragment merging; one Monza result differs from initial prototype and is covered by recorded samples."
  },
