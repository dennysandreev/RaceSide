{
  "name": "raceside",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.15": "1.1.16",
      "brace-expansion@5.0.6": "5.0.7",
      "js-yaml@4.2.0": "4.3.0",
      "postcss": "8.5.10",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node worker/cli.mjs",
    "worker:rss": "node worker/cli.mjs rss.fetch_all",
    "worker:social": "node worker/cli.mjs social.fetch_all",
    "worker:social:reddit": "node worker/cli.mjs social.fetch_reddit",
    "worker:social:telegram": "node worker/cli.mjs social.fetch_telegram",
    "worker:social:x": "node worker/cli.mjs social.fetch_x",
    "worker:social:ai": "node worker/cli.mjs social.process_ai",
    "worker:social:metrics": "node worker/cli.mjs social.refresh_metrics",
    "worker:social:retry": "node worker/cli.mjs social.retry_failed",
    "worker:ai": "node worker/cli.mjs ai.process_news",
    "worker:ai:retry-fallback": "node worker/cli.mjs ai.reprocess_fallback_news",
    "worker:rehighlight": "node worker/cli.mjs ai.rehighlight_news",
    "worker:source-images": "node worker/cli.mjs news.backfill_source_images",
    "worker:news:audit": "node worker/cli.mjs news.audit_recent --limit 50",
    "worker:news:audit:apply": "node worker/cli.mjs news.audit_recent --limit 50 --apply",
    "worker:news:retry": "node worker/cli.mjs news.retry_dedup",
    "worker:retag": "node worker/cli.mjs ai.retag_news",
    "worker:digest": "node worker/cli.mjs ai.generate_daily_digest",
    "worker:polls": "node worker/cli.mjs polls.generate_next_race",
    "worker:calendar": "node worker/cli.mjs jolpica.sync_calendar",
    "worker:results": "node worker/cli.mjs jolpica.sync_results",
    "worker:repair-results": "node worker/cli.mjs jolpica.repair_race_results",
    "worker:repair-qualifying": "node worker/cli.mjs jolpica.repair_qualifying_results",
    "worker:standings": "node worker/cli.mjs jolpica.sync_standings",
    "worker:history:backfill": "node worker/cli.mjs jolpica.backfill_season",
    "worker:history:assets": "node worker/cli.mjs jolpica.sync_season_assets",
    "worker:history:validate": "node worker/cli.mjs jolpica.validate_season",
    "worker:history:prepare": "node worker/cli.mjs jolpica.prepare_history",
    "worker:history:publish": "node worker/cli.mjs jolpica.publish_history",
    "worker:weather": "node worker/cli.mjs weather.sync_weekend",
    "worker:openf1-results": "node worker/cli.mjs openf1.sync_results",
    "worker:starting-grid": "node worker/cli.mjs openf1.sync_starting_grid",
    "worker:openf1-check-current": "node worker/cli.mjs openf1.check_current_sessions",
    "worker:laps": "node worker/cli.mjs openf1.sync_laps",
    "worker:score": "node worker/cli.mjs predictions.score",
    "worker:notifications": "node worker/cli.mjs notifications.enqueue",
    "worker:notifications:dispatch": "node worker/cli.mjs notifications.dispatch",
    "worker:billing:email": "node worker/cli.mjs billing.process_emails",
    "worker:billing:expire": "node worker/cli.mjs billing.expire_subscriptions",
    "worker:billing:expire-orders": "node worker/cli.mjs billing.expire_orders",
    "worker:billing:reconcile-tribute": "node worker/cli.mjs billing.reconcile_tribute",
    "worker:billing:reconcile-yoomoney": "node worker/cli.mjs billing.reconcile_yoomoney",
    "worker:billing:retry-events": "node worker/cli.mjs billing.retry_failed_events",
    "worker:billing:audit": "node worker/cli.mjs billing.audit",
    "worker:ops:watch": "node worker/cli.mjs ops.watch",
    "worker:support:daily": "node worker/cli.mjs support.send_daily_report",
    "worker:reports": "node worker/cli.mjs reports.check_latest",
    "worker:reports:all": "node worker/cli.mjs reports.generate_all_completed",
    "worker:reports:refresh": "node worker/cli.mjs reports.refresh_due",
    "worker:reports:summary": "node worker/cli.mjs reports.generate_summary",
    "worker:circuit-stats": "node worker/cli.mjs circuit_stats.sync_all",
    "supabase:smtp": "node scripts/configure-supabase-smtp.mjs",
    "supabase:auth": "node scripts/configure-supabase-smtp.mjs",
    "preview:seed": "node scripts/seed-preview-engagement.mjs",
    "preview:cleanup": "node scripts/cleanup-preview-engagement.mjs",
    "telegram:authorize": "node scripts/telegram-authorize.mjs",
    "lint": "eslint .",
    "check:repository": "node scripts/check-repository-hygiene.mjs",
    "test:repository": "node --test scripts/check-repository-hygiene.test.mjs",
    "test:fantasy-assets": "node --test src/data/fantasy-track-assets.test.mjs",
    "test:fantasy-scoring": "node scripts/check-fantasy-scoring.mjs",
    "test:fantasy-league-avatar": "node --experimental-strip-types --test src/lib/fantasy-league-avatar.test.mjs",
    "test:notifications": "node --test worker/notification-rules.test.mjs worker/job-run-policy.test.mjs",
    "test:ai-usage": "node --test worker/ai-usage.test.mjs",
    "test:openf1-results": "node --test worker/openf1-session-results.test.mjs worker/openf1-starting-grid.test.mjs",
    "test:news-dedup": "node --test worker/news-deduplication.test.mjs",
    "test:historical-seasons": "node --test worker/historical-seasons.test.mjs src/data/historical-preview.test.mjs",
    "test:season-navigation": "node --experimental-strip-types --test src/lib/season-navigation.test.mjs",
    "test:season-points": "node --experimental-strip-types --test src/lib/f1-points.test.mjs",
    "test:polymarket": "node --experimental-strip-types --test src/lib/polymarket-race-match.test.mjs",
    "test:security": "node --experimental-strip-types --test src/lib/admin-security-boundary.test.mjs src/lib/social-media-storage.test.mjs",
    "test:admin": "node --experimental-strip-types --test src/lib/admin-corrections.test.mjs worker/ai-budget.test.mjs src/lib/admin-operations.test.mjs src/lib/admin-security-boundary.test.mjs src/lib/admin-ai-prompts.test.mjs worker/adaptive-job-schedule.test.mjs worker/ai-prompt-registry.test.mjs worker/ai-usage.test.mjs",
    "test:ops": "node --experimental-strip-types --test src/lib/admin-agent/findings.test.mjs src/lib/admin-agent/health.test.mjs src/lib/admin-agent/schema.test.mjs worker/cli-loop.test.mjs worker/ops-heartbeat.test.mjs worker/ops-watcher.test.mjs worker/support-report.test.mjs worker/support-telegram.test.mjs",
    "assets:history:teams": "node scripts/check-f1-historical-team-assets.mjs",
    "assets:history:circuits": "python3 scripts/review-f1-circuit-maps.py --require-approved",
    "assets:history:avatars": "node scripts/check-f1-driver-avatars.mjs",
    "assets:history:inventory": "node scripts/check-f1-driver-avatars.mjs --inventory-only",
    "track:3d:export": "node --experimental-strip-types scripts/track-model-blender/export-track-data.mjs",
    "track:3d:build": "node --experimental-strip-types scripts/track-model-blender/build-track.mjs",
    "track:3d:validate": "node scripts/track-model-blender/validate-track.mjs",
    "track:fantasy:build": "python3 scripts/generate-fantasy-track-assets.py",
    "track:fantasy:coverage": "python3 scripts/generate-fantasy-track-assets.py --validate-only",
    "track:fantasy:validate": "python3 scripts/generate-fantasy-track-assets.py --validate-only",
    "test:share-links": "node --experimental-strip-types --test worker/share-link-code.test.mjs",
    "test:social-pipeline": "node --test scripts/check-social-pipeline.mjs",
    "test:sentry": "node --test sentry-scrub.test.mjs",
    "typecheck": "tsc --noEmit",
    "live": "node worker/live/server.mjs",
    "live:replay": "LIVE_DATA_SOURCE=replay node worker/live/server.mjs",
    "test:live": "node --test worker/live/*.test.mjs",
    "test:telemetry": "node --experimental-strip-types --test worker/telemetry/*.test.mjs src/features/telemetry/lib/*.test.mjs",
    "test:billing": "node --experimental-strip-types --test src/lib/billing/access-policy.test.mjs src/lib/billing/billing.test.mjs src/lib/billing/order-state.test.mjs src/lib/billing/providers/lava-event.test.mjs src/lib/billing/providers/lava.test.mjs src/lib/billing/subscription-display.test.mjs worker/tribute-reconciliation.test.mjs worker/yoomoney-reconciliation.test.mjs supabase/functions/yoomoney-webhook/logic.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@radix-ui/react-slot": "1.2.5",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sentry/nextjs": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.17.0",
    "mqtt": "5.15.2",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.8.0",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.6.0",
    "telegram": "^2.26.22",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  }
}
